#!/bin/bash
# Install openswe-wave byte-identically into ~/.claude/skills and ~/.codex/skills.
#
# openswe-wave is the source of record for the wave scripts, so unlike
# openswe-run's installer this vendors nothing: it copies its own tracked files.
# Every install stamps INSTALLED with the commit it came from, so a machine can
# be asked what it is running instead of the answer being unknowable. Re-running
# is idempotent and is the upgrade path.
#
# Usage: install [--check]
#   --check   report drift against this source and exit non-zero if any; write nothing.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHECK_ONLY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) CHECK_ONLY=1; shift ;;
    *) echo "install: unknown argument: $1" >&2; exit 2 ;;
  esac
done

fail() { echo "install: $*" >&2; exit 1; }

MANIFEST="SKILL.md scripts/openswe_wave.py scripts/wave-monitor scripts/anchor-sweep scripts/trace-digest references/adjudication-checklist.md references/comment-templates.md references/recovery-runbook.md"
EXECUTABLES="scripts/wave-monitor scripts/anchor-sweep scripts/trace-digest"
# Written by this script, not tracked; listed so the stale sweep spares it.
STAMP="INSTALLED"

for file in $MANIFEST; do
  [[ -f "$HERE/$file" ]] || fail "source is missing $file (run this from the skill directory in a checkout)"
done

# Provenance. A dirty tree is recorded as such rather than silently implying the
# commit is what is installed.
commit="unknown"
if git -C "$HERE" rev-parse --git-dir >/dev/null 2>&1; then
  commit="$(git -C "$HERE" rev-parse HEAD 2>/dev/null || echo unknown)"
  if ! git -C "$HERE" diff --quiet HEAD -- "$HERE" 2>/dev/null; then
    commit="$commit+dirty"
  fi
fi

targets=("$HOME/.claude/skills/openswe-wave" "${CODEX_HOME:-$HOME/.codex}/skills/openswe-wave")

if (( CHECK_ONLY )); then
  drift=0
  for target in "${targets[@]}"; do
    if [[ ! -d "$target" ]]; then
      echo "check: $target is not installed"
      drift=1
      continue
    fi
    for file in $MANIFEST; do
      if ! cmp -s "$HERE/$file" "$target/$file"; then
        echo "check: $target/$file differs from source"
        drift=1
      fi
    done
    if [[ -f "$target/$STAMP" ]]; then
      echo "check: $target <- $(head -1 "$target/$STAMP")"
    else
      echo "check: $target has no $STAMP stamp (installed before provenance tracking)"
      drift=1
    fi
  done
  (( drift )) && { echo "check: drift detected; re-run install to correct it" >&2; exit 1; }
  echo "check: both installs match this source"
  exit 0
fi

# Stage the complete skill, so a target is never written from a partially read source.
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/scripts" "$STAGE/references"
for file in $MANIFEST; do
  cp "$HERE/$file" "$STAGE/$file"
done
chmod +x $(printf "$STAGE/%s " $EXECUTABLES)
printf '%s from %s on %s\n' "$commit" "$HERE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STAGE/$STAMP"

install_to() {
  local target="$1"
  mkdir -p "$target/scripts" "$target/references"
  local file
  for file in $MANIFEST $STAMP; do
    cp "$STAGE/$file" "$target/$file"
  done
  # cp preserves an existing destination's mode, so re-assert the bits every
  # documented invocation depends on rather than inheriting a stale one.
  chmod +x $(printf "$target/%s " $EXECUTABLES)
  for file in $MANIFEST; do
    cmp -s "$STAGE/$file" "$target/$file" || fail "verification failed: $target/$file differs after copy"
  done
  for file in $EXECUTABLES; do
    [[ -x "$target/$file" ]] || fail "verification failed: $target/$file is not executable"
  done
  # Nothing extra may shadow the manifest (stale files from older installs).
  # Scoped to the directories the manifest owns, and skipping dot-entries: a
  # target that is also a checkout must keep its .git, and the sweep must never
  # delete this installer if someone copied the source tree into place.
  local stray relative keep
  while IFS= read -r stray; do
    relative="${stray#"$target"/}"
    case "$relative" in
      .*|*/.*) continue ;;
    esac
    keep=0
    for file in $MANIFEST; do
      [[ "$relative" == "$file" ]] && { keep=1; break; }
    done
    (( keep )) || { echo "install: removing stale file ${stray}" >&2; rm -f "$stray"; }
  done < <(find "$target/scripts" "$target/references" -type f ! -path "*/__pycache__/*" 2>/dev/null)
  rm -rf "$target/scripts/__pycache__"
}

for target in "${targets[@]}"; do
  install_to "$target"
  echo "installed: $target ($(echo $MANIFEST | wc -w | tr -d ' ') files, byte-verified)"
done

# The two installs must match each other exactly, not merely each match the source.
for file in $MANIFEST; do
  cmp -s "${targets[0]}/$file" "${targets[1]}/$file" \
    || fail "cross-verification failed: $file differs between claude and codex installs"
done
echo "verified: claude and codex copies are byte-identical (source commit: $commit)"
